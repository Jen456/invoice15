diff --git a/static/css/facturaporaqui.css b/static/css/facturaporaqui.css
new file mode 100644
index 0000000000000000000000000000000000000000..ac9aee678a08b26092a4ac96a87d8e16bf835480
--- /dev/null
+++ b/static/css/facturaporaqui.css
@@ -0,0 +1,13 @@
+/* FacturaPorAquí: shared primitives, scoped to fp-* components. */
+:root{--fp-ink:#163b50;--fp-muted:#526975;--fp-coral:#ca462c;--fp-coral-dark:#aa3822;--fp-sky:#44badd;--fp-tint:#e5f1f6;--fp-line:#d7e3e9;--fp-bg:#f5f8fa;--fp-success:#23624b;--fp-warning:#775112;--fp-error:#a32f2c;--fp-radius:14px}
+.fp-ui{color:var(--fp-ink);font:400 16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.fp-ui *{box-sizing:border-box}.fp-ui h1,.fp-ui h2,.fp-ui h3{color:var(--fp-ink);line-height:1.2;letter-spacing:-.02em}.fp-ui h1{font-size:clamp(1.6rem,3vw,2.1rem)}.fp-ui h2{font-size:1.25rem;margin:4px 0 14px}.fp-ui h3{font-size:1.05rem}.fp-ui p{margin:0 0 12px}.fp-ui a{color:#225f79}.fp-ui [hidden],.fp-dialog [hidden]{display:none!important}
+.fp-ui :focus-visible,.fp-dialog :focus-visible,.fp-form-actions :focus-visible{outline:3px solid #1b718e!important;outline-offset:3px!important;box-shadow:none!important}.fp-ui button,.fp-ui input,.fp-ui select,.fp-ui textarea{font:inherit}.fp-ui button{cursor:pointer}.fp-ui button:disabled,.fp-ui [aria-disabled=true]{cursor:not-allowed;opacity:.7}
+.fp-btn-primary,.fp-btn-secondary,.fp-btn-text{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;border-radius:8px;padding:9px 16px;font-size:.94rem;font-weight:600;text-decoration:none;line-height:1.35;border:1px solid transparent;white-space:normal}.fp-btn-primary{background:var(--fp-coral);color:#fff!important;border-color:var(--fp-coral)}.fp-btn-primary:hover{background:var(--fp-coral-dark);border-color:var(--fp-coral-dark)}.fp-btn-secondary{color:var(--fp-ink)!important;background:#fff;border-color:#9aafbb}.fp-btn-secondary:hover{background:var(--fp-tint);border-color:var(--fp-ink)}.fp-btn-text{color:#225f79!important;background:transparent;padding-inline:8px}.fp-btn-text:hover{text-decoration:underline;background:#f1f7fa}
+.fp-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border:1px solid #c6dbe5;border-radius:6px;color:var(--fp-ink);background:#eff7fa;font-size:.78rem;font-weight:650;line-height:1.5}.fp-chip-warning{color:var(--fp-warning);background:#fff7e7;border-color:#e6cc99}.fp-chip-success{color:var(--fp-success);background:#edf7f1;border-color:#b7d7c5}.fp-chip-muted{background:#f1f3f5;color:#52616b;border-color:#d4dde2}.fp-chip-error{color:var(--fp-error);background:#fff1ef;border-color:#e9c1ba}
+.fp-section{background:#fff;border:1px solid var(--fp-line);border-radius:var(--fp-radius);padding:24px;margin:0 0 20px;min-width:0}.fp-section-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}.fp-section-heading h2{margin-bottom:4px}.fp-eyebrow{font-size:.73rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:#526975}.fp-help,.fp-optional{font-size:.84rem;color:var(--fp-muted)}.fp-help{display:block;margin:6px 0 12px}.fp-optional{font-weight:400}
+.fp-alert,.fp-callout{padding:14px 16px;border-radius:8px;background:#edf5f9;border:1px solid #c7dce6;color:var(--fp-ink);margin-bottom:18px;overflow-wrap:anywhere}.fp-alert p:last-child,.fp-callout p:last-child{margin-bottom:0}.fp-alert-error{background:#fff4f2;color:#832722;border-color:#e8bbb1}.fp-alert-warning{background:#fff8e9;color:#68480d;border-color:#e7cea3}.fp-callout{border-left:3px solid #2f89a8;font-size:.9rem}.fp-callout strong{display:block;margin-bottom:4px}.fp-alert ul{margin:8px 0 0;padding-left:20px}.fp-status:empty{display:none}.fp-status{color:var(--fp-muted);font-size:.9rem}
+.fp-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.fp-span-2{grid-column:span 2}.fp-ui .form-group{margin-bottom:14px;min-width:0}.fp-ui label{display:block;font-size:.9rem;font-weight:600;margin:0 0 7px}.fp-ui .form-control,.fp-ui select,.fp-ui textarea,.fp-dialog .form-control{border:1px solid #a7bac6;border-radius:8px;min-height:44px;color:var(--fp-ink);background:#fff;font-size:1rem;max-width:100%}.fp-ui .form-control:disabled{color:#465f6d;background:#f1f6f8;opacity:1}.fp-ui textarea{resize:vertical}.fp-field-error,.fp-ui .invalid-feedback{display:block;font-size:.84rem;color:var(--fp-error);margin-top:6px}.fp-ui [aria-invalid=true],.fp-dialog [aria-invalid=true]{border-color:var(--fp-error)!important}.fp-field-footer{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;font-size:.8rem;color:var(--fp-muted);margin-top:6px}.fp-field-footer small:last-child{white-space:nowrap}
+.fp-table-region{max-width:100%;overflow:auto;border-radius:8px;position:relative}.fp-ui table{border-collapse:collapse;width:100%;font-size:.9rem}.fp-ui th{text-align:left;font-size:.78rem;color:#425f6f;background:#eff5f8;font-weight:650;padding:12px 14px}.fp-ui td{padding:14px;border-bottom:1px solid var(--fp-line);vertical-align:middle}.fp-numeric{text-align:right!important;font-variant-numeric:tabular-nums;white-space:nowrap}.fp-ui caption{color:var(--fp-muted);text-align:left;padding:10px 0}
+.fp-empty{padding:32px 20px;text-align:center;color:var(--fp-muted)}.fp-empty strong{display:block;color:var(--fp-ink);font-size:1.06rem;margin:10px 0}.fp-empty p{max-width:480px;margin:0 auto 16px}.fp-link{color:#225f79;text-decoration:underline;text-underline-offset:3px}.fp-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+@media(max-width:767px){.fp-section{padding:18px 16px}.fp-section-heading{align-items:flex-start;flex-wrap:wrap}.fp-form-grid{grid-template-columns:1fr;gap:8px}.fp-span-2{grid-column:auto}.fp-ui h2{font-size:1.15rem}}
+@media(prefers-reduced-motion:reduce){.fp-ui *,.fp-dialog *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
