# FacturaPorAquí — avanza los lotes de importación (RIDE en PDF) y reintenta en el SRI los XML que no
# se pudieron recuperar (manage.py procesar_importaciones). Lo lanza facturaporaqui-importacion@%i.timer.
[Unit]
Description=FacturaPorAquí (%i) - procesamiento de importaciones
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=facturaporaqui
Group=facturaporaqui
WorkingDirectory=/opt/facturaporaqui/%i/current
EnvironmentFile=/etc/facturaporaqui/%i.env
Environment=XDG_CACHE_HOME=/tmp
ExecStart=/opt/facturaporaqui/%i/current/.venv/bin/python manage.py procesar_importaciones
TimeoutStartSec=15min
UMask=0027
MemoryMax=600M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/facturaporaqui/datos/%i/archivos /home/facturaporaqui/datos/%i/firmas /home/facturaporaqui/logs/%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
