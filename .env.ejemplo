# Variables de FacturaPorAquí. Copia este archivo como .env (desarrollo) o usa
# /etc/facturaporaqui/<entorno>.env en los servidores. Nunca versiones el real.
FPA_ENTORNO=desarrollo
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/facturaporaqui
# Claves Fernet separadas por comas (la primera cifra; las demás solo descifran).
FPA_CLAVES_CIFRADO=
FPA_ARCHIVOS=
FPA_FIRMAS=
FPA_LOGS=
FPA_X_ACCEL_PREFIX=
STATIC_ROOT=
SECURE_HSTS_SECONDS=0
# En local, para ver los correos (p. ej. el enlace de confirmación del registro) en la consola:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Aplicación WEB de PayPhone Developer (ambiente PRUEBAS en app.facturaporaqui.com).
# URL de respuesta registrada en PayPhone: https://<dominio>/suscripcion/pago/retorno/
PAYPHONE_TOKEN=
# Opcional: vacío = la tienda asociada al token.
PAYPHONE_STORE_ID=
FPA_URL_APP=
FPA_CORREO_FACTURACION=bill@facturaporaqui.com
