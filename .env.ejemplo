# Variables de FacturaPorAquí. Copia este archivo como .env (desarrollo) o usa
# /etc/facturaporaqui/<entorno>.env en los servidores. Nunca versiones el real.
FPA_ENTORNO=desarrollo
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/facturaporaqui
# Claves Fernet separadas por comas (la primera cifra; las demás solo descifran).
FPA_CLAVES_CIFRADO=
FPA_ARCHIVOS=
FPA_FIRMAS=
FPA_LOGS=
FPA_X_ACCEL_PREFIX=
STATIC_ROOT=
SECURE_HSTS_SECONDS=0
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
